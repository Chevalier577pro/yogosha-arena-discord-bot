# Token du bot Discord (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Identifiant de la competition a suivre. Obligatoire : aucune valeur par defaut.
# Tu le trouves dans l'URL publique de la competition :
#   https://hsg.yogosha.com/public/competitions/<COMPETITION_ID>
COMPETITION_ID=

# Base de l'API publique
ARENA_BASE_URL=https://hsg.yogosha.com

# Duree du cache en secondes (evite de spammer l'API)
CACHE_TTL_SECONDS=30

# Laisse vide = commandes GLOBALES (dispo sur tous les serveurs qui invitent le bot,
# propagation jusqu'a 1 h). Renseigne un ID de serveur uniquement pour tester
# instantanement sur ton propre serveur.
GUILD_ID=

# N'est PAS a definir en local. Render/Railway/Fly l'injectent automatiquement :
# s'il est present, le bot demarre un serveur de sante sur http://localhost:<PORT>/health
# PORT=
